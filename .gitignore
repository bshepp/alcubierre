# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.Python
build/
dist/
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Sweep outputs (large parquet + per-run config snapshots).
# Keep the directory placeholder so the layout is reproducible.
sweeps/*.parquet
sweeps/*.config.json
!sweeps/.gitkeep

# Local working copies of sweep results downloaded from HF Dataset
# bshepp/alcubierre-sweeps. Re-fetchable via `hf download`.
sweeps_remote/

# Heavy regeneratable symbolic artifacts from Task 2D.5e (~15 MB each).
# The serialised symbolic FH stress-energy expressions are very large
# (hundreds of erf+exp+rational terms per S_ij component). Re-built in
# ~15 sec by `python -m hf_jobs.analysis.fell_heisenberg_symbolic --out-dir fell_heisenberg_symbolic --subtask 2`.
# The validation JSON files in fell_heisenberg_symbolic/ are kept (they
# are small).
fell_heisenberg_symbolic/symbolic_artifacts.py

# Environment + secrets
.env
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~

# Cursor
.cursor/

# Coverage / test caches
.coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/

# Extracted paper sources (regenerable from papers/*.tar.gz)
papers/extracted/

# Original (pre-slim) heavy paper PDFs and tarballs.  See papers/_originals/README.md.
# These are kept locally for safe rollback after running agent-tools/slim_papers.py
# but are too large for git history.  The slimmed versions in papers/ root are the
# canonical committed copies.
papers/_originals/

# Agent tool scratch: one-off diagnostics, fixes, inspection, dumps, run
# logs. Reusable verification/adjudication harnesses are NOT scratch -- they
# live in the tracked verification/ directory. Four long-documented general
# utilities are kept in place (negated below) so their documented paths in
# AGENTS.md stay valid.
agent-tools/*
!agent-tools/run_nb.py
!agent-tools/clear_outputs.py
!agent-tools/slim_pdf.py
!agent-tools/slim_papers.py
# Small reproducibility-critical data artifacts the tracked verification/
# harnesses load, and evidence behind load-bearing TRUST_AUDIT anchors.
# Negation-tracked in place so the harnesses' paths keep resolving.
!agent-tools/_radial_opt_knots.json
!agent-tools/cross_check_xact_result.json
!agent-tools/cross_check_xact_sweep.json
!agent-tools/_aniso_step2_opt.json
